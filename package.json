{
  "name": "codebench",
  "version": "1.0.0",
  "private": true,
  "description": "A focused, streaming AI code reviewer.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.1.0"
  }
}
